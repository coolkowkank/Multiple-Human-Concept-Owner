{
  "seats": {
    "builder": {
      "role": "builder",
      "allowed_paths": ["docs/"],
      "adapter": {
        "type": "http",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "openai/gpt-oss-120b",
        "api_key_env": "GROQ_API_KEY",
        "max_tokens": 4000,
        "reasoning_effort": "low"
      }
    }
  }
}
