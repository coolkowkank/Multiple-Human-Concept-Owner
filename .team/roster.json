{
  "seats": {
    "builder": {
      "role": "builder",
      "allowed_paths": [
        "launcher/brief_lint.py",
        "tests/test_brief_lint.py"
      ],
      "adapter": {
        "type": "http",
        "base_url": "https://api.groq.com/openai/v1",
        "model": "openai/gpt-oss-120b",
        "api_key_env": "GROQ_API_KEY",
        "max_tokens": 7000,
        "reasoning_effort": "low"
      }
    }
  }
}