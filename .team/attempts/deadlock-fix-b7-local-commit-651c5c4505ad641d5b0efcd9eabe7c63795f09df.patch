@@ -0,0 +1,64 @@
+import os, time, unittest
+from unittest.mock import MagicMock, patch
+
+# Import Supervisor after adjusting sys.path if needed
+from launcher.supervisor import Supervisor
+
+class DummyBus:
+    def __init__(self):
+        self.state_data = {}
+        self.logs = []
+        self.gates = []
+    def state(self):
+        return self.state_data.copy()
+    def write_state(self, state):
+        self.state_data = state.copy()
+    def append_log(self, src, kind, msg):
+        self.logs.append((src, kind, msg))
+    def commit_all(self, msg):
+        pass
+    def open_gate(self, src, text, **kwargs):
+        self.gates.append((src, text))
+    def roster(self):
+        return {"seats": {"coordinator": {}}}
+
+class TestSupervisorFix(unittest.TestCase):
+    def setUp(self):
+        self.bus = DummyBus()
+        self.sup = Supervisor(repo=".")
+        self.sup.bus = self.bus
+        self.sup.procs = {}
+        self.sup._stalled_seats = set()
+        self.sup._notified_gates = set()
+        self.sup.restart_limit = 5
+        self.sup.stall_timeout = 5
+    def test_utc_parse_no_stall(self):
+        # turn_since 5 seconds ago UTC
+        ts = time.time() - 5
+        utc = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))
+        self.bus.state_data = {"turn":"coordinator","status":"running","turn_since":utc}
+        # set TZ to UTC+2
+        os.environ["TZ"] = "Europe/Berlin"
+        time.tzset()
+        self.sup._check_stall(self.bus.state())
+        self.assertNotIn("stall", [k for _,k,_ in self.bus.logs])
+    def test_routing_failure_reissue(self):
+        self.bus.state_data = {"status":"running"}
+        self.sup._check_stall(self.bus.state())
+        self.assertEqual(self.bus.state_data.get("turn"), "coordinator")
+        self.assertIn(("supervisor","routing-failure","routing failure detected; state: "), [(src,kind,msg[:21]) for src,kind,msg in self.bus.logs])
+    def test_routing_failure_escalate(self):
+        # first occurrence
+        self.bus.state_data = {"status":"running"}
+        self.sup._check_stall(self.bus.state())
+        # second occurrence should trigger escalation gate
+        self.sup._check_stall(self.bus.state())
+        self.assertTrue(any("escalating" in txt for _,txt in self.bus.gates))
+    def test_done_status_no_action(self):
+        self.bus.state_data = {"status":"done","turn":None}
+        self.sup._check_stall(self.bus.state())
+        self.assertEqual(len(self.bus.logs),0)
+        self.assertNotIn("routing-failure", [k for _,k,_ in self.bus.logs])
+
+if __name__ == '__main__':
+    unittest.main()
